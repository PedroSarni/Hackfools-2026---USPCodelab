{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "dist-electron",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "composite": true,
    "noEmitOnError": true
  },
  "include": ["desktop/**/*.ts", "preload/**/*.ts", "shared/**/*.ts"]
}
